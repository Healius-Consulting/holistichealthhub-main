{
  "name": "@hhh/api-sql",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/functions.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/bootstrap/*.test.ts src/security/*.test.ts src/transport/portal/*.test.ts src/transport/public/*.test.ts src/application/**/*.test.ts src/domain/**/*.test.ts src/providers/**/*.test.ts src/repositories/**/*.test.ts",
    "seed:referral-links": "tsx src/migration/seed-referral-link-secrets.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.0",
    "@google-cloud/storage": "^7.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
