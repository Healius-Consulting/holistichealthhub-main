# Public browser configuration for the staff portal. These values identify the
# Firebase web app; they are not service-account credentials or integration keys.
VITE_APP_ENV=local
VITE_APP_URL=http://localhost:5173
# Production always uses same-origin /v1 routing. This override is development-only.
VITE_API_BASE_URL=
VITE_ELIGIBILITY_FORM_URL=http://localhost:5174/eligibility
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_APP_CHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key
VITE_REQUIRE_APP_CHECK=false
VITE_REQUIRE_MFA=true
VITE_AUTH_MODE=cookie

# Curaleaf, Worldpay and service-account secrets belong in Google Secret
# Manager/Firebase Functions configuration. Never add them as VITE_* values.
# Worldpay server endpoints belong in services/api-sql/.env for local TRY testing.
# Order-flow delivery/adapters are server-only too:
# EMAIL_FROM_ADDRESS=noreply@holistichealthhub.cc
# EMAIL_REPLY_TO_ADDRESS=support@holistichealthhub.cc
# RESEND_API_KEY_SECRET_RESOURCE_NAME=projects/hhh26-4ebd2/secrets/hhh-resend-api-key-europe-west2
# PATIENT_MESSAGE_PROVIDER_URL=https://provider.example/messages
# PATIENT_MESSAGE_PROVIDER_KEY=replace-in-secret-manager
# CURALEAF_HOLD_URL_TEMPLATE=https://supplier.example/purchase-orders/{purchaseOrderId}/hold
# CURALEAF_RENEWAL_ATTACH_URL_TEMPLATE=https://supplier.example/purchase-orders/{purchaseOrderId}/renewal
# CURALEAF_LINE_EXCLUSION_URL_TEMPLATE=https://supplier.example/prescriptions/{prescriptionId}/exclude-line
